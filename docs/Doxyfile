# Doxygen configuration for the public API. Run from the repository root:
#   doxygen docs/Doxyfile
PROJECT_NAME           = RoboticsCore
PROJECT_BRIEF          = "Classical robotics algorithms in modern C++"
OUTPUT_DIRECTORY       = build/docs
INPUT                  = include/roboticscore docs/README.md
FILE_PATTERNS          = *.hpp *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = docs/README.md
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
EXCLUDE_SYMBOLS        = detail::* roboticscore::detail
STRIP_FROM_PATH        = include
FULL_PATH_NAMES        = YES
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
USE_MATHJAX            = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
WARN_IF_UNDOCUMENTED   = NO
WARN_NO_PARAMDOC       = NO
QUIET                  = YES
