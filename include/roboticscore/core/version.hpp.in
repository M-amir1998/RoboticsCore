#pragma once

/// @file version.hpp
/// @brief Library version information (generated by CMake).

#include <string_view>

#define ROBOTICSCORE_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define ROBOTICSCORE_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define ROBOTICSCORE_VERSION_PATCH @PROJECT_VERSION_PATCH@

namespace roboticscore {

/// Semantic version of the library the headers belong to.
inline constexpr std::string_view kVersionString = "@PROJECT_VERSION@";

/// Version of the compiled library. Differs from kVersionString only when headers
/// and binaries from different releases are mixed.
std::string_view version() noexcept;

}  // namespace roboticscore
